-- Breakables cache.
local BreakablePositions = { data = nil, timestamp = 0, ttl = 2 }
local breakablePositionCache = setmetatable({}, { __mode = "k" })

local function getBreakablePositions()
	local now = os.clock()
	if BreakablePositions.data and (now - BreakablePositions.timestamp) < BreakablePositions.ttl then
		return BreakablePositions.data
	end
	local folder = getBreakables()
	if not folder then return {} end
	local list = {}
	for _, model in ipairs(folder:GetChildren()) do
		if model:IsA("Model") then
			local cached = breakablePositionCache[model]
			if not cached then
				local hitbox = model:FindFirstChild("Hitbox")
				if hitbox and hitbox:IsA("BasePart") then
					cached = { position = hitbox.Position, id = model.Name }
					breakablePositionCache[model] = cached
				end
			end
			if cached then
				table.insert(list, cached)
			end
		end
	end
	BreakablePositions.data = list
	BreakablePositions.timestamp = now
	return list
end

-- Eggs cache.
local EggPositions = { data = nil, timestamp = 0, ttl = 2 }
local eggPositionCache = setmetatable({}, { __mode = "k" })

local function getMap()
	local ok, map = pcall(worldCmds.GetMap)
	if ok then return map end
	return nil
end

local function getEggPositions()
	local now = os.clock()
	if EggPositions.data and (now - EggPositions.timestamp) < EggPositions.ttl then
		return EggPositions.data
	end
	local map = getMap()
	if not map then return {} end
	local eggsFolder = map:FindFirstChild("Eggs")
	if not eggsFolder then return {} end
	local list = {}
	for _, group in ipairs(eggsFolder:GetChildren()) do
		if group.ClassName ~= "Folder" then continue end
		local eggs = group:FindFirstChild("Eggs")
		if not eggs then continue end
		for _, egg in ipairs(eggs:GetChildren()) do
			local eggId = egg:GetAttribute("ID")
			local unlocked = egg:GetAttribute("Unlocked")
			if not eggId or not unlocked then continue end
			local cached = eggPositionCache[egg]
			if not cached then
				local center = egg:FindFirstChild("Center")
				if center and center:IsA("BasePart") then
					cached = { eggId = eggId, position = center.Position }
					eggPositionCache[egg] = cached
				end
			end
			if cached then
				table.insert(list, cached)
			end
		end
	end
	EggPositions.data = list
	EggPositions.timestamp = now
	return list
end

-- Memoization.
local DerivedCache = {}
local DERIVED_TTL = 5

local function memoize(key, fn)
	local entry = DerivedCache[key]
	local now = os.clock()
	if entry and (now - entry.timestamp) < DERIVED_TTL then
		return entry.value
	end
	local value = fn()
	DerivedCache[key] = { value = value, timestamp = now }
	return value
end

local function clearDerivedCache()
	DerivedCache = {}
end

local function getEggIdList()
	return memoize("eggIds", function()
		local ids = {}
		for id, egg in pairs(directory.Eggs or {}) do
			if typeof(egg) == "table" and egg.displayName then
				table.insert(ids, id)
			end
		end
		table.sort(ids)
		return ids
	end)
end

-- Webhook.
local function sendWebhook(url, payload)
	if not url or url == "" then return false end
	local clean, issues = reqCheck()
	if not clean then
		warn("[VRT] Webhook skipped, request has issues:", table.concat(issues, ","))
		return false
	end
	local ok, body = pcall(httpService.JSONEncode, httpService, payload)
	if not ok then return false end
	return pcall(function()
		request({
			Url = url,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = body,
		})
	end)
end

