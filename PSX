Core.OpenEgg = function()
	if variables.OpeningEgg > 0 then return end
	local root = getRoot()
	if not root then return end
	local rootPos = root.Position
	local eggs = getEggPositions()
	local nearestEgg, nearestDist = nil, math.huge
	for _, egg in ipairs(eggs) do
		local d = (egg.position - rootPos).Magnitude
		if d < nearestDist then
			nearestEgg, nearestDist = egg, d
		end
	end
	if not nearestEgg or nearestDist > 50 then return end
	pcall(network.Invoke, "Buy Egg", nearestEgg.eggId, false, false)
end

